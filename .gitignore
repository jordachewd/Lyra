# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Root-level rules for the whole monorepo. `web/` and `studio/` keep their own
# .gitignore for framework-specific artifacts.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Planning docs & AI / agent tooling - local only, never published
docs/
.agents/
.claude/
.cursor/
.aider*
.playwright-mcp/
.mcp.json
skills-lock.json

