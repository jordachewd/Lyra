# Copy to .env.local and fill in the values for your own Sanity project.

# --- Public build-time variables ---

# Canonical base URL used for metadata, robots, sitemap and the web manifest
NEXT_PUBLIC_SITE_URL=https://example.com

# Sanity project the site reads from
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-11

# Client-side reCAPTCHA v3 site key (custom forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Server-side variables (all optional; unset disables the feature) ---

# Read token for draft preview (local development only)
SANITY_READ_TOKEN=

# Shared secret validating Sanity revalidation webhooks
SANITY_WEBHOOK_SECRET=

# Server-side reCAPTCHA v3 secret (custom forms)
RECAPTCHA_SECRET_KEY=

# Endpoint that receives validated custom-form submissions
LEAD_RELAY_URL=
